config lucinexus 'global'
	option enabled '1'
	option port '9999'
	option dry_run '1'
	option auto_rollback '1'
	option enable_fastpath '1'
	option sparse_hydration '1'
	option max_retries '2'
	option timeout '25'

config api 'api'
	option provider 'gemini'
	option model 'gemini-2.5-flash'
	option key ''
	option endpoint ''
	option auth_header 'Authorization'
	option auth_prefix 'Bearer '
	option protocol 'openai-compatible'
